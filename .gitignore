# Build artifacts. Every CMake build tree this repo or its CI creates is
# named build*/ — build, build-test, build-wasm, build-audit,
# build-coverage, build-san (sanitizers.yml), build-native (wasm.yml).
# No tracked path starts with "build", so the glob cannot swallow sources.
build*/
cmake-build-*/
dist-wasm/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile

# Binaries and libraries
*.o
*.obj
*.a
*.so
*.dylib
*.dll
*.exe
fast_mnist_nn
homework4

# Editor and temp files
*~
*.swp

# Perf outputs and logs
*.out
*.log
perf.data*
perf.hist.*

# Data and archives
*.zip
*.pgm
data/
TrainingSetList.txt
TestingSetList.txt

# Doxygen output
docs/doxygen/

# Web frontend
web/node_modules/
web/dist/
web/playwright-report/
web/test-results/
# web/public/wasm is COMMITTED: git-driven Vercel builds must ship the
# real simd128 artifacts, not the JS fallback.

# Compiled binaries
test_model
fast_mnist_cli
fast_mnist_server
fast_mnist_trainer

# macOS
.DS_Store

# Claude Code workspace
# - .claude/settings.json is tracked (project permission allowlist)
# - .claude/settings.local.json is machine-specific
# - .claude/worktrees/ is agent ephemeral
.claude/settings.local.json
.claude/worktrees/

# Vercel CLI: the local project link and `vercel build` output.
.vercel
