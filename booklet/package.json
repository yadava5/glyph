{
  "name": "glyph-booklet",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Glyph System Card — a printed 8.5×11 booklet exported to PDF via Puppeteer.",
  "scripts": {
    "dev": "vite --port 5182",
    "build": "tsc --noEmit && vite build",
    "build:embed": "tsc --noEmit && vite build --base=/system-card/ --outDir ../web/public/system-card --emptyOutDir",
    "preview": "vite preview --port 5182",
    "pdf": "node scripts/validate-parity.mjs && node scripts/export-pdf.mjs"
  },
  "dependencies": {
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "qrcode.react": "^4.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.3.4",
    "puppeteer": "^25.7.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
